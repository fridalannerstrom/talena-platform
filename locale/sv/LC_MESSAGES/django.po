#: .\apps\processes\purpose_context_config.py:7
msgid "Role context"
msgstr "Rollkontext"

#: .\apps\processes\purpose_context_config.py:8
msgid ""
"Add role information to tailor candidate insights, questions and "
"recommendations to this hiring process."
msgstr ""
"Lägg till information om rollen för att anpassa kandidatinsikter, frågor och "
"rekommendationer till den här rekryteringsprocessen."

#: .\apps\processes\purpose_context_config.py:10
msgid "Role title"
msgstr "Rolltitel"

